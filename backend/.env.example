# ==============================================================================
# Order Checker Backend - Environment Configuration Example
# Copy this file to .env or pass as an environment file (--env-file .env).
# For sensitive credentials, prefer Docker Secrets in containerized deployments.
#
# NOTE: Shopee access and refresh tokens are dynamically stored in Redis and
#       managed at runtime via the Admin UI, so they are omitted from this file.
#       See documentation for optional initial token seeding parameters.
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployment & Compose Configuration
# ------------------------------------------------------------------------------
PORT=8000
DB_PORT=5432
REDIS_PORT=6379
DB_CONTAINER_NAME=backend-postgres-1
REDIS_CONTAINER_NAME=backend-redis-1
KEYS_VOLUME=./data/keys
LOGS_VOLUME=./logs
# ENV_FILE=.env

# ------------------------------------------------------------------------------
# Database & Redis Infrastructure
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0
# Optional host override when DATABASE_URL contains localhost inside Docker
# DB_HOST=backend-postgres-1

# ------------------------------------------------------------------------------
# Admin & Initial Account Configuration
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Application Logging
# ------------------------------------------------------------------------------
# Console / Docker logs level (default: WARNING)
LOG_LEVEL=WARNING
LOG_LEVEL_CONSOLE=WARNING
# Rotating file log level (default: DEBUG)
LOG_LEVEL_FILE=DEBUG
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# Security, JWT & Key Management (Optional overrides with defaults shown)
# ------------------------------------------------------------------------------
KEYS_DIR=data/keys
KEY_CACHE_TTL_SECONDS=300
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=86400
REFRESH_CLEANUP_INTERVAL_SECONDS=3600
JWT_ALGORITHM=RS256
JWT_AUDIENCE=api.bakingholic:v0.3a
JWT_ISSUER=auth.bakingholic:v0.3a
JWT_LEEWAY_SECONDS=30.0
WS_TICKET_TTL_SECONDS=30
SHOPEE_CONFIG_UNLOCK_TTL_SECONDS=120

# ------------------------------------------------------------------------------
# Shopee OpenAPI Configuration
# ------------------------------------------------------------------------------
PARTNER_ID=123456
PARTNER_KEY=shpk123456
SHOP_ID=123456
SHOPEE_URL=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_CACHE_TTL_SECONDS=120
SHOPEE_MAX_CONCURRENCY=5
SHOPEE_MAX_RETRIES=3
SHOPEE_BACKOFF_DELAY=1.5
SHOPEE_PAGE_SIZE=100
SHOPEE_ORDER_CHUNK_SIZE=50
SHOPEE_PACKAGE_CHUNK_SIZE=50
SHOPEE_SYNC_WINDOW_DAYS=2
