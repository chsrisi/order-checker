# ==============================================================================
# Order Checker Backend - Environment Configuration Example
# Copy this file to .env or pass as an environment file (--env-file .env).
# For sensitive credentials, prefer Docker Secrets in containerized deployments.
#
# NOTE: Shopee access and refresh tokens are dynamically stored in Redis and
#       managed at runtime via the Admin UI, so they are omitted from this file.
#       See documentation for optional initial token seeding parameters.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment profile: development | staging | production
# Unset or unknown means production rules (fail closed). See docs/OPERATIONS.md.
# ------------------------------------------------------------------------------
APP_ENV=development

# ------------------------------------------------------------------------------
# Deployment & Compose Configuration
# ------------------------------------------------------------------------------
PORT=8000
DB_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
DB_CONTAINER_NAME=backend-postgres-1
REDIS_CONTAINER_NAME=backend-redis-1
ADMIN_WEB_CONTAINER_NAME=admin-web-1
KEYS_VOLUME=./data/keys
LOGS_VOLUME=./logs
# ENV_FILE=.env

# ------------------------------------------------------------------------------
# Database & Redis Infrastructure
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0
# Optional host override when DATABASE_URL contains localhost inside Docker
# DB_HOST=backend-postgres-1

# ------------------------------------------------------------------------------
# Admin & Initial Account Configuration
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# CORS_ORIGINS (development): '*' (default) allows any origin. A comma-separated list
# (e.g. http://localhost:3000) also permits localhost/127.0.0.1 on any port, or the
# CORS_ORIGIN_REGEX you set (e.g. Tailscale / LAN subnets).
# Production/staging: leave EMPTY (no CORS; admin web is same-origin behind nginx, the
# operator client is native). '*' and CORS_ORIGIN_REGEX refuse startup.
CORS_ORIGINS=*
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|100\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+)(:\d+)?$

# ------------------------------------------------------------------------------
# Application Logging
# ------------------------------------------------------------------------------
# Console / Docker logs level (default: WARNING)
LOG_LEVEL=WARNING
LOG_LEVEL_CONSOLE=WARNING
# Rotating file log level (default: DEBUG)
LOG_LEVEL_FILE=DEBUG
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# Versioning: the backend version comes from pyproject.toml ([project].version).
# API_VERSION may override it in development only.
# ------------------------------------------------------------------------------
# API_VERSION=0.0.0-dev

# ------------------------------------------------------------------------------
# Security, JWT & Key Management (Optional overrides with defaults shown)
# ------------------------------------------------------------------------------
KEYS_DIR=data/keys
# Published operator-app APKs and latest.json for OTA updates (scripts.publish_client_release)
CLIENT_RELEASES_DIR=data/releases/client
KEY_CACHE_TTL_SECONDS=300
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=86400
REFRESH_CLEANUP_INTERVAL_SECONDS=3600
JWT_ALGORITHM=RS256
# Token identity defaults per environment: api.bakingholic:<APP_ENV> / auth.bakingholic:<APP_ENV>.
# Override only deliberately; changing them logs every device out. JWT_VERSION is deprecated.
# JWT_AUDIENCE=api.bakingholic:development
# JWT_ISSUER=auth.bakingholic:development
JWT_LEEWAY_SECONDS=30.0
WS_TICKET_TTL_SECONDS=30
SHOPEE_CONFIG_UNLOCK_TTL_SECONDS=120

# ------------------------------------------------------------------------------
# Shopee OpenAPI Configuration
# ------------------------------------------------------------------------------
PARTNER_ID=123456
PARTNER_KEY=shpk123456
SHOP_ID=123456
SHOPEE_URL=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_CACHE_TTL_SECONDS=120
SHOPEE_MAX_CONCURRENCY=5
SHOPEE_MAX_RETRIES=3
SHOPEE_BACKOFF_DELAY=1.5
SHOPEE_PAGE_SIZE=100
SHOPEE_ORDER_CHUNK_SIZE=50
SHOPEE_PACKAGE_CHUNK_SIZE=50
SHOPEE_SYNC_WINDOW_DAYS=2
# Background Shopee sync interval in seconds (0 = off); paused after a token error.
SHOPEE_AUTO_SYNC_SECONDS=300

# ------------------------------------------------------------------------------
# Mock & Offline Development Settings / Bypass Schemes
# ------------------------------------------------------------------------------
# Set to 1, true, yes, or on to enable the mock order bypass.
# When enabled, failures during Shopee API synchronization (e.g. offline dev,
# sandbox downtime, unconfigured credentials) are caught and bypassed so existing
# database orders (such as synthetic orders from `python -m scripts.seed_dev`) are
# served directly rather than failing the request.
# Default is 0 (disabled) for strict production behavior.
MOCK_ORDER_BYPASS=0

# Defaults: on in development, off under production rules (must stay off there).
# ALLOW_REGISTRATION=1
# Interactive API docs (/docs, /redoc, /openapi.json). Default on in development only.
# EXPOSE_API_DOCS=1

# Stock location mode: multi (default, an item may be stocked in several bins) or
# single (at most one location per item). Both are valid in production.
# The old SINGLE_LOCATION_STOCK_BYPASS / STOCK_SINGLE_LOCATION_BYPASS flags are
# deprecated aliases used only when STOCK_LOCATION_MODE is unset.
STOCK_LOCATION_MODE=multi


