# ==============================================================================
# Order Checker Backend - PRODUCTION environment example (non-sensitive values only)
# Use with:  docker compose -f compose.yaml -f compose.prod.yaml up -d --build
# Secrets (database_url, admin_password, partner_key, redis_password, redis_url,
# postgres_password, app_password) live in backend/.secrets/ files, never here.
# ==============================================================================
APP_ENV=production

PORT=8000
WEB_PORT=3000
KEYS_VOLUME=./data/keys
LOGS_VOLUME=./logs

ADMIN_USERNAME=admin
# Leave empty: no CORS (admin web is same-origin behind nginx; the client is native).
CORS_ORIGINS=

LOG_LEVEL=WARNING
LOG_LEVEL_CONSOLE=WARNING
LOG_LEVEL_FILE=INFO
LOG_FORMAT=json
LOG_TO_FILE=true

# Shopee (live). PARTNER_KEY comes from .secrets/partner_key.
PARTNER_ID=
SHOP_ID=
SHOPEE_URL=https://partner.shopeemobile.com

# Must stay off in production (startup refuses otherwise).
MOCK_ORDER_BYPASS=0
ALLOW_REGISTRATION=0

# Recipient data retention in days (default 30, max 90 per Shopee DPP).
RECIPIENT_RETENTION_DAYS=30
