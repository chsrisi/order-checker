server {
    listen ${WEB_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression for Flutter Web assets
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/x-javascript
        application/javascript
        application/xml
        application/json
        application/wasm;
    gzip_disable "MSIE [1-6]\.";

    # Security headers. nginx drops server-level add_header directives in any location that
    # sets its own, so every location below repeats them explicitly.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Flutter web output is NOT content-hashed: main.dart.js, flutter_bootstrap.js, assets/*
    # keep their names in every build. Browsers must revalidate them (cheap 304 via ETag),
    # otherwise a redeployed admin keeps running the previous build.
    location ~* \.(?:ico|css|js|mjs|json|gif|jpe?g|png|woff2?|eot|ttf|otf|svg|wasm)$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # index.html and the runtime .env are never stored, so configuration changes apply on reload
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ~ ^/(assets/)?\.env$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # Vue console (T7.1). ^~ keeps the regex locations above away from /console/. Vite
    # content-hashes everything under assets/, so it may be cached for good; index.html is
    # revalidated so a redeploy is picked up on the next load. Unknown paths go to the SPA.
    location = /console {
        # relative Location: nginx's absolute redirect would name its internal port (80), not
        # the published one
        absolute_redirect off;
        return 301 /console/;
    }

    location ^~ /console/assets/ {
        # no "always": a 404 (old tab asking for a file from a previous build) must not be cached
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    location ^~ /console/ {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri /console/index.html;
    }

    # Reverse proxy backend API endpoints (same-origin, eliminates CORS in Docker hosting)
    location ~ ^/(auth|admin|outbound|items|stocks|shopee|pick-items|meta|\.well-known)(/|$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy backend WebSocket endpoint
    location /ws {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # SPA routing: any route not directly matching a static file falls back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
