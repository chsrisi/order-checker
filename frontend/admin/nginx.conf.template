server {
    listen ${WEB_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression for Flutter Web assets
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/x-javascript
        application/javascript
        application/xml
        application/json
        application/wasm;
    gzip_disable "MSIE [1-6]\.";

    # Cache control for static assets (hashed or immutable)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|wasm)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Ensure index.html and assets/.env are never cached by the browser
    # so runtime configuration updates take effect immediately on reload
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /assets/.env {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /.env {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Reverse proxy backend API endpoints (same-origin, eliminates CORS in Docker hosting)
    location ~ ^/(auth|admin|outbound|items|stocks|shopee|pick_items|\.well-known)(/|$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy backend WebSocket endpoint
    location /ws {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # SPA routing: any route not directly matching a static file falls back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
