# ==============================================================================
# Frontend Admin Web & Desktop - Environment Configuration Example
# Copy this file to .env before running locally or building container images.
#
# IMPORTANT SECURITY & AGENT POLICY:
# - Active .env files contain live runtime secrets, credentials, or sensitive hosts.
# - Automated agents and code review tools MUST ONLY inspect .env.example templates.
# - Never commit .env to version control (.env is listed in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API & WebSocket Connection Settings
# ------------------------------------------------------------------------------
# BASE: Hostname or IP of the backend server.
# For local desktop/browser development, use 'localhost'.
# For Android emulator (if applicable), use '10.0.2.2'.
# For network/remote deployment, specify your domain or backend IP.
BASE=localhost

# BASE_URL: Full HTTP/HTTPS root URL of the Order Checker backend API.
# Note: Flutter Web and desktop clients use this base URL for REST requests.
BASE_URL=http://${BASE}:8000

# WS_URL: Full WS/WSS root URL of the Order Checker backend WebSocket endpoint.
# Real-time updates (orders, users, stock changes) are streamed over this socket.
WS_URL=ws://${BASE}:8000

# ------------------------------------------------------------------------------
# Web Hosting & Server Configuration (Used when running in Docker or Web Host)
# ------------------------------------------------------------------------------
# WEB_PORT: The local or container listening port for the Nginx web server.
# In Docker container deployments, this defines the internal listen port.
# Default container listen port is 80 (or 3000 when mapped via Docker Compose).
WEB_PORT=80

# WEB_HOST: Interface binding address for the web server (default: 0.0.0.0).
WEB_HOST=0.0.0.0

# WEB_BASE_HREF: Base href path when the Flutter Web app is hosted under a
# sub-path or reverse proxy path prefix (e.g. '/' or '/admin/'). Default is '/'.
WEB_BASE_HREF=/

# ------------------------------------------------------------------------------
# Backend CORS Coordination Note
# ------------------------------------------------------------------------------
# When hosting the frontend admin as a web application on a browser:
# Ensure the web origin (e.g., http://localhost:3000 or https://admin.yourdomain.com)
# is included in the backend's CORS_ORIGINS environment variable in backend/.env:
# CORS_ORIGINS=http://localhost:3000
